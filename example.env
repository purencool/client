# -----------------------------------------------------------------------------
# USER CONFIGURATION
# -----------------------------------------------------------------------------

# DEFAULT_USER
# Description: The default user profile identifier used when no user is logged in
DEFAULT_USER=default.user

# PROFILE_KEY
# Description: API key for authenticating user profile requests
PROFILE_KEY=''

# PROFILE_TOKEN
# Description: Authentication token for user sessions
PROFILE_TOKEN=''

# -----------------------------------------------------------------------------
# EMAIL/SMTP CONFIGURATION
# -----------------------------------------------------------------------------

# SMTP_HOST
# Description: The hostname or IP address of the SMTP server
SMTP_HOST=smtp.example.com

# SMTP_PORT
# Description: The port number for SMTP connection
SMTP_PORT=587

# SMTP_USERNAME
# Description: Username for SMTP authentication
SMTP_USERNAME=your_username

# SMTP_PASSWORD
# Description: Password for SMTP authentication
SMTP_PASSWORD=your_password

# SMTP_FROM
# Description: The email address that appears in the "From" field
SMTP_FROM=your_email@example.com

# -----------------------------------------------------------------------------
# REST API CONFIGURATION
# -----------------------------------------------------------------------------

# REST_API_APP_SERVICE
# Description: Base URL for the REST API service
REST_API_APP_SERVICE=''

REST_API_APP_SERVICE_AI=''
REST_API_APP_SERVICE_AI_KEY=''
REST_API_APP_SERVICE_AI_MODEL=''


# REST_API_APP_SERVICE_DEV
# Description: Development mode flag for API service
REST_API_APP_SERVICE_DEV=false

